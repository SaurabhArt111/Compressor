# Copy this file to .env (or set these as real environment variables) to
# tune the server for your deployment. Every value below is optional - the
# app runs fine with none of these set.

# --- Networking -------------------------------------------------------
PORT=5000
HOST=0.0.0.0
# Comma-separated list of allowed origins, e.g. https://compressor.example.com
# Leave unset to allow any origin ("*"), which is fine for a same-origin
# self-hosted deployment (the default docker-compose / npm start setup).
CORS_ORIGIN=

# --- Storage ------------------------------------------------------------
# Where uploaded/compressed files live. Defaults to server/uploads.
UPLOAD_ROOT=
# Where the compression-history JSON file lives. Defaults to server/data/history.json.
HISTORY_FILE=

# --- Limits ---------------------------------------------------------------
# Per-file upload ceiling in bytes. Default: 2147483648 (2GB). Raise this if
# you routinely work with sources larger than 2GB.
MAX_UPLOAD_BYTES=2147483648
# Max files accepted in a single upload/job.
MAX_FILES_PER_JOB=2000
# Hard ceiling on parallel image/PDF compressions across all jobs, regardless
# of what a client requests via the concurrency setting in the UI.
MAX_SERVER_CONCURRENCY=4
# Default concurrency when a client doesn't specify one.
DEFAULT_CONCURRENCY=2
# How many embedded images inside a single PDF are recompressed in parallel.
PDF_IMAGE_CONCURRENCY=4

# --- Quality search bounds -------------------------------------------------
QUALITY_FLOOR_DEFAULT=35
QUALITY_CEILING_DEFAULT=100
QUALITY_ABSOLUTE_FLOOR=20

# --- Retention --------------------------------------------------------------
# How long finished jobs' files stay on disk before the hourly cleanup sweep
# removes them (milliseconds). Default: 86400000 (24h).
JOB_RETENTION_MS=86400000
CLEANUP_INTERVAL_MS=3600000

NODE_ENV=production
